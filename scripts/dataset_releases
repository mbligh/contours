#!/usr/bin/env python3
"""Versioned dataset releases, deterministic Pages assembly, and post-deploy retention."""
import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import tarfile
import urllib.request

DATASETS = {
    'shipping': {'shipping/shipping.geojson', 'shipping/shipping_extra.geojson',
                 'shipping/shipping_fedex.geojson', 'shipping/shipping_ups_boxes.geojson',
                 'shipping/shipping.js'},
    'contours': {'contours.pmtiles'},
    'contour-vectors': {'contours.geojsonseq.gz', 'contours.geojsonseq.gz.sha256', 'extraction.json'},
}
PAGE_DATASETS = ('shipping', 'contours')
TAG = re.compile(r'^dataset-(shipping|contours|contour-vectors)-[0-9]+-[0-9]+$')
REPO = os.environ.get('GITHUB_REPOSITORY', 'mbligh/mapping')


def gh(*args, json_result=False):
    result = subprocess.check_output(['gh', *args], text=True)
    return json.loads(result) if json_result else result


def releases():
    pages = gh('api', '--paginate', '--slurp', f'repos/{REPO}/releases?per_page=100', json_result=True)
    return [r for page in pages for r in page]


def complete(release, dataset):
    return (not release['draft'] and TAG.fullmatch(release['tag_name']) is not None
            and release['tag_name'].startswith(f'dataset-{dataset}-')
            and {a['name'] for a in release['assets']} >= {'dataset.tar.gz', 'manifest.json'})


def ordered(items, dataset):
    return sorted((r for r in items if complete(r, dataset)),
                  key=lambda r: (r['published_at'], r['id']), reverse=True)


def sha256(path):
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def write_json(path, data):
    Path(path).write_text(json.dumps(data, sort_keys=True, indent=2) + '\n')


def create(dataset, root, input_manifest=None):
    root = Path(root)
    for name in DATASETS[dataset]:
        if not (root / name).is_file():
            raise ValueError(f'Missing dataset file: {name}')
    target = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
    run = os.environ['GITHUB_RUN_ID']
    tag = f"dataset-{dataset}-{run}-{os.environ['GITHUB_RUN_ATTEMPT']}"
    out = Path('build/release')
    out.mkdir(parents=True, exist_ok=True)
    archive = out / 'dataset.tar.gz'
    with tarfile.open(archive, 'w:gz') as tar:
        for name in sorted(DATASETS[dataset]):
            tar.add(root / name, arcname=name, recursive=False)
    manifest = {'schema': 1, 'dataset': dataset, 'tag': tag, 'commit': target,
                'run': f'https://github.com/{REPO}/actions/runs/{run}',
                'sha256': sha256(archive),
                'files': {name: sha256(root / name) for name in sorted(DATASETS[dataset])}}
    if input_manifest:
        manifest['input'] = json.loads(Path(input_manifest).read_text())
    write_json(out / 'manifest.json', manifest)
    # A draft is invisible to selection until BOTH uploads have completed.
    gh('release', 'create', tag, '--repo', REPO, '--target', target, '--draft',
       '--title', f'{dataset.title()} dataset {run}', '--notes', json.dumps(manifest, indent=2))
    gh('release', 'upload', tag, str(archive), str(out / 'manifest.json'), '--repo', REPO)
    gh('release', 'edit', tag, '--repo', REPO, '--draft=false', '--latest=false')
    print(f'Published {tag}')


def extract(archive, output, dataset, manifest):
    with tarfile.open(archive) as tar:
        members = tar.getmembers()
        names = [m.name for m in members]
        if set(names) != DATASETS[dataset] or len(names) != len(set(names)):
            raise ValueError('Unexpected or duplicate archive members')
        for member in members:
            path = PurePosixPath(member.name)
            if not member.isfile() or path.is_absolute() or '..' in path.parts:
                raise ValueError('Unsafe archive member')
            destination = output / member.name
            destination.parent.mkdir(parents=True, exist_ok=True)
            with tar.extractfile(member) as src, destination.open('wb') as dst:
                shutil.copyfileobj(src, dst)
            if sha256(destination) != manifest['files'][member.name]:
                raise ValueError(f'Invalid checksum for {member.name}')
    if dataset == 'contours':
        path = output / 'contours.pmtiles'
        with path.open('rb') as stream:
            if stream.read(7) != b'PMTiles' or path.stat().st_size <= 10000:
                raise ValueError('Invalid PMTiles archive')
    else:
        for name in DATASETS[dataset]:
            if name.endswith('.geojson'):
                data = json.loads((output / name).read_text())
                if data.get('type') != 'FeatureCollection' or not data.get('features'):
                    raise ValueError(f'Invalid or empty GeoJSON: {name}')


def download_release(dataset, release, output):
    dest = Path('build/download') / dataset
    dest.mkdir(parents=True, exist_ok=True)
    gh('release', 'download', release['tag_name'], '--repo', REPO,
       '--pattern', 'dataset.tar.gz', '--pattern', 'manifest.json', '--dir', str(dest), '--clobber')
    manifest = json.loads((dest / 'manifest.json').read_text())
    if (manifest['schema'] != 1 or manifest['dataset'] != dataset
            or manifest['tag'] != release['tag_name']
            or set(manifest['files']) != DATASETS[dataset]
            or sha256(dest / 'dataset.tar.gz') != manifest['sha256']):
        raise ValueError(f'Invalid {dataset} release manifest or archive checksum')
    extract(dest / 'dataset.tar.gz', Path(output), dataset, manifest)
    return manifest


def download(dataset, output, tag, allow_missing, selection):
    candidates = ordered(releases(), dataset)
    if tag:
        candidates = [r for r in candidates if r['tag_name'] == tag]
    if not candidates:
        if allow_missing and not tag:
            print('Waiting for the first contour-vector release; extraction will trigger the build.')
            return False
        raise ValueError(f'No complete {dataset} release found for {tag or "latest"}')
    release = candidates[0]
    manifest = download_release(dataset, release, output)
    Path(selection).parent.mkdir(parents=True, exist_ok=True)
    write_json(selection, {dataset: release['id']})
    write_json(str(Path(selection).with_suffix('.manifest.json')), {
        'release_id': release['id'], 'manifest': manifest})
    print(f"Using {release['tag_name']}")
    return True


def assemble(output):
    all_releases = releases()
    selected = {}
    for dataset in PAGE_DATASETS:
        candidates = ordered(all_releases, dataset)
        if not candidates:
            print(f'Waiting for the first complete {dataset} release; existing Pages left intact.')
            return False
        selected[dataset] = candidates[0]
    # Include static-file hashes and asset update metadata, so direct asset edits
    # are caught even if the tag and source commit have not changed.
    state = {'datasets': {k: {'id': r['id'], 'tag': r['tag_name'], 'assets': [
        {key: a.get(key) for key in ('id', 'name', 'size', 'updated_at', 'digest')}
        for a in sorted(r['assets'], key=lambda a: a['name'])]}
        for k, r in selected.items()},
        'static': {str(p): sha256(p) for directory in ('site', 'public')
                   for p in sorted(Path(directory).rglob('*')) if p.is_file()}}
    try:
        with urllib.request.urlopen(f'https://{REPO.split("/")[0]}.github.io/{REPO.split("/")[1]}/mapping-build.json', timeout=30) as response:
            if json.load(response) == state:
                print('Published inputs are unchanged.')
                return False
    except (OSError, ValueError):
        pass
    output = Path(output)
    output.mkdir(parents=True, exist_ok=True)
    for dataset, release in selected.items():
        download_release(dataset, release, output)
    # Static content overlays datasets; public/ is the final user-controlled overlay.
    for directory in ('site', 'public'):
        if Path(directory).exists():
            shutil.copytree(directory, output, dirs_exist_ok=True)
    (output / '.nojekyll').touch()
    write_json(output / 'mapping-build.json', state)
    Path('build').mkdir(exist_ok=True)
    write_json('build/selected-releases.json', {k: r['id'] for k, r in selected.items()})
    return True


def expired(items, selected, keep=3):
    """Never delete a release newer than the one this deployment used."""
    victims = []
    for dataset, deployed_id in selected.items():
        candidates = ordered(items, dataset)
        index = next(i for i, release in enumerate(candidates) if release['id'] == deployed_id)
        victims.extend(candidates[index + keep:])
    return victims


def cleanup(selection):
    for release in expired(releases(), json.loads(Path(selection).read_text())):
        tag = release['tag_name']
        # Only our strictly named generated releases and their matching tags.
        gh('release', 'delete', tag, '--repo', REPO, '--yes', '--cleanup-tag')
        print(f'Deleted expired dataset release and tag: {tag}')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    create_parser = sub.add_parser('create')
    create_parser.add_argument('dataset', choices=DATASETS)
    create_parser.add_argument('root')
    create_parser.add_argument('--input-manifest')
    download_parser = sub.add_parser('download')
    download_parser.add_argument('dataset', choices=DATASETS)
    download_parser.add_argument('output')
    download_parser.add_argument('--tag', default='')
    download_parser.add_argument('--allow-missing', action='store_true')
    download_parser.add_argument('--selection', default='build/vector-selection.json')
    assemble_parser = sub.add_parser('assemble')
    assemble_parser.add_argument('--output', default='.pages')
    cleanup_parser = sub.add_parser('cleanup')
    cleanup_parser.add_argument('--selection', default='build/selected-releases.json')
    args = parser.parse_args()
    if args.command == 'create':
        create(args.dataset, args.root, args.input_manifest)
    elif args.command == 'download':
        found = download(args.dataset, args.output, args.tag, args.allow_missing, args.selection)
        if os.environ.get('GITHUB_OUTPUT'):
            with open(os.environ['GITHUB_OUTPUT'], 'a') as stream:
                stream.write(f'found={str(found).lower()}\n')
    elif args.command == 'assemble':
        changed = assemble(args.output)
        if os.environ.get('GITHUB_OUTPUT'):
            with open(os.environ['GITHUB_OUTPUT'], 'a') as stream:
                stream.write(f'changed={str(changed).lower()}\n')
    else:
        cleanup(args.selection)
