#!/usr/bin/env python3
"""Exercise CLI extraction offline; substitute only the remote DuckDB connection."""
import contextlib
import io
import json
from pathlib import Path
import runpy
import sys
import tempfile
import types
import unittest
from unittest.mock import patch

SCRIPT = Path(__file__).resolve().with_name('overture')


class Connection:
    def __init__(self):
        self.queries = []
        self.rows = []
        self.description = []

    def execute(self, sql, params=None):
        if sql.startswith('DESCRIBE'):
            self.rows = [(name,) for name in ('id', 'names', 'bbox', 'addresses', 'brand', 'basic_category', 'confidence', 'operating_status')]
        elif params is not None:
            assert '\\n' not in sql, 'SQL must use real newlines'
            self.queries.append((sql, params))
            if 'GROUP BY' in sql:
                self.rows = [('supermarket', 2)]
                return self
            self.description = [(name,) for name in ('id', 'name', 'lon', 'lat', 'street')]
            def row(name):
                return (name.lower(), name, -74.7, 40.7, '123 Main St')
            if '%Costco%' in params or 'costco' in params:
                self.rows = [row('Costco')]
            elif '%Home Depot%' in params:
                self.rows = [row('Home Depot')]
            elif '%Missing%' in params:
                self.rows = []
            else:
                self.rows = [row('Category match')]
        return self

    def fetchall(self):
        return self.rows


class OvertureTests(unittest.TestCase):
    def run_cli(self, flags, explicit_output=True):
        con = Connection()
        fake = types.SimpleNamespace(connect=lambda: con)
        with tempfile.TemporaryDirectory() as temp:
            out = Path(temp) / 'stores.geojson'
            argv = [str(SCRIPT), '--release', '2026-09-23.0', *flags]
            if explicit_output:
                argv += ['-o', str(out)]
            with patch.dict(sys.modules, {'duckdb': fake}), patch.object(sys, 'argv', argv), \
                    contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                runpy.run_path(str(SCRIPT), run_name='__main__')
            return con.queries, json.loads(out.read_text()) if out.exists() else None

    def test_stdout_output_is_json_without_creating_a_file(self):
        for output_args in ([], ['-o', '-'], ['--output', '-']):
            with self.subTest(output_args=output_args), tempfile.TemporaryDirectory() as temp:
                con = Connection()
                stdout, stderr = io.StringIO(), io.StringIO()
                argv = [str(SCRIPT), '--release', '2026-09-23.0',
                        '--name', 'Costco', '--name', 'Home Depot', *output_args]
                with contextlib.chdir(temp), patch.dict(sys.modules, {'duckdb': types.SimpleNamespace(connect=lambda: con)}), \
                        patch.object(sys, 'argv', argv), contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
                    runpy.run_path(str(SCRIPT), run_name='__main__')
                self.assertFalse(stdout.closed, 'Do not close the caller stdout stream')
                result = json.loads(stdout.getvalue())
                self.assertEqual([f['properties']['name'] for f in result['features']], ['Costco', 'Home Depot'])
                self.assertTrue(stdout.getvalue().endswith('\n'))
                self.assertIn('Overture release:', stderr.getvalue())
                self.assertIn('Wrote 2 places to stdout', stderr.getvalue())
                self.assertEqual(list(Path(temp).iterdir()), [], 'No output file, including a literal dash')

    def test_multiple_names_query_independently_and_concatenate(self):
        queries, result = self.run_cli(['--name', 'Costco', '--name', 'Home Depot', '--category', 'hardware_store', '--min-confidence', '0.8'])
        self.assertEqual(len(queries), 2)
        for index, (_, params) in enumerate(queries):
            own, other = ('%Costco%', '%Home Depot%') if index == 0 else ('%Home Depot%', '%Costco%')
            self.assertIn(own, params)
            self.assertNotIn(other, params)
            self.assertIn('hardware_store', params)
            self.assertIn(0.8, params)
            self.assertIn('NJ', params)
        self.assertEqual([f['properties']['name'] for f in result['features']], ['Costco', 'Home Depot'])
        self.assertEqual(result['overture_release'], '2026-09-23.0')
        self.assertEqual(result['features'][0]['geometry']['coordinates'], [-74.7, 40.7])
        self.assertEqual(result['features'][1]['properties']['street'], '123 Main St')

    def test_empty_query_does_not_discard_other_results(self):
        queries, result = self.run_cli(['--name', 'Missing', '--name', 'Costco'])
        self.assertEqual(len(queries), 2)
        self.assertEqual(len(result['features']), 1)

    def test_combined_results_are_deduplicated_across_queries(self):
        queries, result = self.run_cli(['--name', 'Costco', '--name', 'Costco'])
        self.assertEqual(len(queries), 2)
        self.assertEqual(len(result['features']), 1)

    def test_deduplication_can_be_disabled(self):
        queries, result = self.run_cli(['--name', 'Costco', '--name', 'Costco', '--dedupe-distance-feet', '0'])
        self.assertEqual(len(queries), 2)
        self.assertEqual(len(result['features']), 2)

    def test_single_exact_name(self):
        queries, result = self.run_cli(['--name', 'Costco', '--exact', '--state', 'NY'])
        self.assertEqual(len(queries), 1)
        self.assertIn('costco', queries[0][1])
        self.assertNotIn('%Costco%', queries[0][1])
        self.assertIn('NY', queries[0][1])
        self.assertEqual(len(result['features']), 1)

    def test_category_only_still_queries_once(self):
        queries, result = self.run_cli(['--category', 'supermarket'])
        self.assertEqual(len(queries), 1)
        self.assertNotIn('ILIKE', queries[0][0])
        self.assertEqual(len(result['features']), 1)

    def test_category_listing_still_uses_one_combined_query(self):
        queries, result = self.run_cli(['--list-categories', '--list-level', 'basic', '--name', 'Costco', '--name', 'Home Depot'])
        self.assertEqual(len(queries), 1)
        self.assertIn('%Costco%', queries[0][1])
        self.assertIn('%Home Depot%', queries[0][1])
        self.assertIsNone(result)



class DeduplicationTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        with patch.dict(sys.modules, {'duckdb': types.SimpleNamespace()}):
            cls.dedupe = staticmethod(runpy.run_path(str(SCRIPT))['deduplicate_features'])

    def point(self, name='Store', north_feet=0, confidence=None, id='first'):
        import math
        lat = 40.7 + math.degrees(north_feet * 0.3048 / 6371008.8)
        props = {'name': name, 'id': id, 'street': '57 Main St'}
        if confidence is not None:
            props['confidence'] = confidence
        return {'type': 'Feature', 'geometry': {'type': 'Point', 'coordinates': [-74.7, lat]}, 'properties': props}

    def test_radius_and_same_name_with_normalized_case_and_whitespace(self):
        first = self.point()
        close = self.point('  STORE  ', 99, id='close')
        far = self.point(north_feet=101, id='far')
        different = self.point('Different store', 1)
        self.assertEqual(self.dedupe([first, close, far, different]), [first, far, different])

    def test_highest_confidence_keeps_its_attributes_without_mutation(self):
        import copy
        low = self.point(confidence=0.7)
        high = self.point(north_feet=50, confidence=0.99, id='better')
        high['properties']['street'] = '57 Old Tpke'
        records = [low, high]
        original = copy.deepcopy(records)
        self.assertEqual(self.dedupe(records), [high])
        self.assertEqual(records, original)

    def test_missing_confidence_and_empty_names(self):
        first, duplicate = self.point(), self.point(north_feet=20)
        unnamed1, unnamed2 = self.point(''), self.point('')
        self.assertEqual(self.dedupe([first, duplicate, unnamed1, unnamed2]), [first, unnamed1, unnamed2])
        self.assertEqual(self.dedupe([]), [])

    def test_no_transitive_chain_past_radius(self):
        records = [self.point(north_feet=n, confidence=c) for n, c in [(0, 0.9), (80, 0.8), (160, 0.7)]]
        self.assertEqual(self.dedupe(records), [records[0], records[2]])

    def test_user_example_is_not_nearby(self):
        records = [self.point('Oldwick General Store'), self.point('Oldwick General Store')]
        records[0]['geometry']['coordinates'] = [-74.83706665039062, 40.641754150390625]
        records[1]['geometry']['coordinates'] = [-74.74942779541016, 40.67275619506836]
        self.assertEqual(self.dedupe(records), records)

    def test_custom_radius(self):
        records = [self.point(), self.point(north_feet=150)]
        self.assertEqual(self.dedupe(records), records)
        self.assertEqual(self.dedupe(records, 200), records[:1])


if __name__ == '__main__':
    unittest.main()

