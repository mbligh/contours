#!/bin/bash
scripts/overture --name Costco --exact -o public/geojson/costco
scripts/overture --name 'Tractor Supply' --name 'Tractor Supply Co.' --exact | scripts/uniqgeo > public/geojson/tsc
scripts/overture --name 'Chipotle' | scripts/uniqgeo > public/geojson/chipotle
scripts/overture --name 'Home Depot' --name "The Home Depot" --exact | scripts/uniqgeo > public/geojson/home_depot
scripts/overture --name "Trader Joe's" | scripts/uniqgeo > public/geojson/tjs
scripts/overture --name "Five Guys" -o public/geojson/five_guys
