#!/usr/bin/env python3
"""Read-only NJ USPS source comparison. Requires pyarrow, shapely, scipy, pyshp.

Raw inputs and scratch Parquet extracts stay in --work-dir. Nothing writes to
shipping/ or public/. HTTP range reads download only intersecting row groups.
"""
import argparse
from collections import Counter
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import re
import struct
import time
import urllib.request

import numpy as np
import pyarrow as pa
import pyarrow.compute as pc
import pyarrow.parquet as pq
from scipy.spatial import cKDTree
import shapefile
from shapely import from_wkb
from shapely.geometry import Point, shape

BOX = (-75.57, 38.88, -73.88, 41.36)
ATP = 'https://data.alltheplaces.xyz/runs/latest/output/usps_collection_boxes.geojson'
BOUNDARY = 'https://www2.census.gov/geo/tiger/GENZ2024/shp/cb_2024_us_state_500k.zip'
CATALOG = 'https://stac.overturemaps.org/catalog.json'


def fetch(url, byte_range=None):
    headers = {'User-Agent': 'NJ USPS source comparison; github.com/mbligh/mapping'}
    if byte_range:
        headers['Range'] = 'bytes=%d-%d' % byte_range
    for attempt in range(3):
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=120) as response:
                if byte_range:
                    expected = byte_range[1] - byte_range[0] + 1
                    assert response.status == 206, 'Server ignored byte range'
                    assert response.headers['Content-Range'].startswith('bytes %d-%d/' % byte_range)
                    data = response.read(expected + 1)
                    assert len(data) == expected, 'Truncated/oversized range'
                    return data
                return response.read()
        except Exception:
            if attempt == 2:
                raise
            time.sleep(2 ** attempt)


def cached(url, path):
    if not path.exists():
        temp = path.with_suffix(path.suffix + '.partial')
        temp.write_bytes(fetch(url))
        temp.replace(path)
    return path


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def bbox_filter():
    west, south, east, north = BOX
    return ((pc.field('bbox', 'xmin') <= east) & (pc.field('bbox', 'xmax') >= west)
            & (pc.field('bbox', 'ymin') <= north) & (pc.field('bbox', 'ymax') >= south))


def extract_file(asset, directory, feature_type):
    """Build a local sparse Parquet file from its footer and relevant row groups."""
    url, size = asset['href'], asset['file:size']
    path = directory / url.rsplit('/', 1)[-1]
    done = path.with_suffix('.row-groups.json')
    if not done.exists():
        tail = fetch(url, (size - 8, size - 1))
        assert tail[-4:] == b'PAR1', 'Not Parquet'
        footer_size = struct.unpack('<I', tail[:4])[0] + 8
        footer = fetch(url, (size - footer_size, size - 1))
        with path.open('wb') as stream:
            stream.truncate(size)
            stream.write(b'PAR1')
            stream.seek(size - footer_size)
            stream.write(footer)
        parquet = pq.ParquetFile(path)
        columns = {parquet.metadata.schema.column(i).path: i for i in range(parquet.metadata.num_columns)}
        selected, ranges = [], []
        for i in range(parquet.num_row_groups):
            group = parquet.metadata.row_group(i)
            def stats(name):
                value = group.column(columns[name]).statistics
                assert value is not None and value.has_min_max, 'Missing bbox statistics'
                return value
            west, south, east, north = BOX
            if (stats('bbox.xmin').min > east or stats('bbox.xmax').max < west
                    or stats('bbox.ymin').min > north or stats('bbox.ymax').max < south):
                continue
            selected.append(i)
            spans = []
            for j in range(group.num_columns):
                column = group.column(j)
                offsets = [x for x in [column.dictionary_page_offset, column.data_page_offset] if x is not None and x > 0]
                if offsets and column.total_compressed_size:
                    start = min(offsets)
                    spans.append((start, start + column.total_compressed_size - 1))
            ranges.append((min(a for a, b in spans), max(b for a, b in spans)))
        parquet.close()
        print(feature_type, path.name, 'row groups', len(selected), 'bytes', sum(b-a+1 for a,b in ranges), flush=True)
        with ThreadPoolExecutor(max_workers=4) as pool, path.open('r+b') as stream:
            futures = {pool.submit(fetch, url, span): span for span in ranges}
            for future in as_completed(futures):
                start, end = futures[future]
                stream.seek(start)
                stream.write(future.result())
        done.write_text(json.dumps({'row_groups': selected, 'url': url, 'size': size,
                                   'footer_sha256': hashlib.sha256(footer).hexdigest()}))
    metadata = json.loads(done.read_text())
    parquet = pq.ParquetFile(path)
    chunks = []
    for i in metadata['row_groups']:
        table = parquet.read_row_group(i).filter(bbox_filter())
        if feature_type == 'infrastructure':
            table = table.filter(pc.field('class') == 'post_box')
        if table.num_rows:
            chunks.append(table)
    parquet.close()
    return chunks, metadata


def overture(feature_type, index, directory, boundary):
    target = directory / ('overture-' + feature_type + '-nj.parquet')
    provenance = directory / ('overture-' + feature_type + '-inputs.json')
    if not target.exists():
        selected = index.filter((pc.field('collection') == feature_type) & bbox_filter()).to_pylist()
        assert selected, 'STAC selected no files'
        chunks, inputs = [], []
        for entry in selected:
            tables, source = extract_file(entry['assets']['azure'], directory, feature_type)
            chunks.extend(tables)
            inputs.append(source)
        assert chunks, 'No matching row groups'
        combined = pa.concat_tables(chunks)
        points = [from_wkb(wkb) for wkb in combined['geometry'].to_pylist()]
        keep = [p.geom_type == 'Point' and boundary.covers(p) for p in points]
        combined = combined.filter(pa.array(keep))
        pq.write_table(combined, target)
        provenance.write_text(json.dumps(inputs, indent=2))
    return pq.read_table(target), json.loads(provenance.read_text())


def vectors(coords):
    points = np.radians(np.asarray(coords))
    lon, lat = points[:, 0], points[:, 1]
    return np.column_stack((np.cos(lat)*np.cos(lon), np.cos(lat)*np.sin(lon), np.sin(lat)))


def overlap(atp, boxes):
    if not boxes:
        return {'atp_with_nearby_overture': {str(m): 0 for m in [25, 50, 100]}, 'overture_with_nearby_atp': {str(m): 0 for m in [25, 50, 100]}}
    a = vectors([f['geometry']['coordinates'] for f in atp])
    b = vectors([[from_wkb(f['geometry']).x, from_wkb(f['geometry']).y] for f in boxes])
    distance_a, index_a = cKDTree(b).query(a)
    distance_b, index_b = cKDTree(a).query(b)
    distance_a = 6371000 * 2 * np.arcsin(np.minimum(1, distance_a / 2))
    distance_b = 6371000 * 2 * np.arcsin(np.minimum(1, distance_b / 2))
    return {
        'atp_with_nearby_overture': {str(m): int((distance_a <= m).sum()) for m in [25, 50, 100]},
        'overture_with_nearby_atp': {str(m): int((distance_b <= m).sum()) for m in [25, 50, 100]},
        'note': 'Proximity candidates, not proven duplicates; counts are directional and allow many-to-one matches.',
    }


def source_tags(row):
    return dict(row.get('source_tags') or [])


def carrier(row):
    tags = source_tags(row)
    text = ' '.join(str(tags.get(k, '')) for k in ['operator', 'operator:short', 'brand', 'name'])
    text += ' ' + str((row.get('names') or {}).get('primary') or '')
    if tags.get('operator:wikidata') == 'Q668687' or tags.get('brand:wikidata') == 'Q668687' or re.search(r'\bUSPS\b|United States Postal|U\.?S\.? Postal', text, re.I):
        return 'USPS'
    if re.search(r'\bUPS\b|United Parcel Service', text, re.I):
        return 'UPS'
    if re.search(r'Fed\s*Ex', text, re.I):
        return 'FedEx'
    return 'other' if tags.get('operator') or tags.get('brand') else 'unknown'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--work-dir', type=Path, default=Path('/tmp/usps-source-comparison'))
    parser.add_argument('--release', help='Pin Overture release; otherwise resolve current STAC catalog')
    parser.add_argument('--atp-file', type=Path, help='Reuse a previously downloaded national ATP GeoJSON')
    parser.add_argument('--stac-file', type=Path)
    parser.add_argument('--boundary-file', type=Path)
    args = parser.parse_args()
    args.work_dir.mkdir(parents=True, exist_ok=True)
    atp_path = args.atp_file or cached(ATP, args.work_dir/'atp-usps-boxes.geojson')
    boundary_path = args.boundary_file or cached(BOUNDARY, args.work_dir/'states.zip')
    reader = shapefile.Reader(str(boundary_path))
    boundary = next(shape(record.shape.__geo_interface__) for record in reader.iterShapeRecords() if record.record.as_dict()['STUSPS'] == 'NJ')
    catalog_path = cached(CATALOG, args.work_dir/'catalog.json')
    release = args.release or json.loads(catalog_path.read_text())['latest']
    directory = args.work_dir / release
    directory.mkdir(exist_ok=True)
    index_path = args.stac_file or cached(f'https://stac.overturemaps.org/{release}/collections.parquet', directory/'collections.parquet')
    index = pq.read_table(index_path)
    national = json.loads(atp_path.read_text())['features']
    labelled = [f for f in national if f['properties'].get('addr:state') == 'NJ']
    atp = [f for f in national if boundary.covers(Point(f['geometry']['coordinates']))]
    print('ATP NJ-labelled', len(labelled), 'inside NJ boundary', len(atp), flush=True)
    infra, infra_inputs = overture('infrastructure', index, directory, boundary)
    print('Overture infrastructure post boxes', infra.num_rows, flush=True)
    places, places_inputs = overture('place', index, directory, boundary)
    print('Overture NJ places', places.num_rows, flush=True)
    rows = places.to_pylist()
    atp_ids = {f['id'] for f in atp}
    atp_place_sources = [s for row in rows for s in (row.get('sources') or []) if s.get('dataset') == 'AllThePlaces']
    atp_place_ids = {s.get('record_id') for s in atp_place_sources}
    def postal(row):
        value = json.dumps({k: row.get(k) for k in ['names', 'brand', 'websites', 'taxonomy', 'basic_category']}).lower()
        return any(term in value for term in ['usps', 'postal', 'post office', 'post_office', 'post_box', 'mailbox', 'collection box', 'collection_box'])
    postal_places = [r for r in rows if postal(r)]
    candidates = [r for r in postal_places if any(term in json.dumps({k:r.get(k) for k in ['names','taxonomy','basic_category']}).lower() for term in ['post_box','collection_box','collection box','mailbox'])]
    boxes = infra.to_pylist()
    usps = [r for r in boxes if carrier(r) == 'USPS']
    unknown = [r for r in boxes if carrier(r) == 'unknown']
    times = [r for r in usps if source_tags(r).get('collection_times')]
    atp_by_ref = {f['properties']['ref']: f for f in atp}
    ref_matches = [r for r in usps if source_tags(r).get('ref') in atp_by_ref]
    both_times = [r for r in ref_matches if source_tags(r).get('collection_times')]
    identical_times = [r for r in both_times if source_tags(r)['collection_times'] == atp_by_ref[source_tags(r)['ref']]['properties']['collection_times']]
    sources = Counter(s.get('dataset') for r in boxes for s in (r.get('sources') or []))
    place_sources = Counter(s.get('dataset') for r in postal_places for s in (r.get('sources') or []))
    sample = []
    for r in postal_places:
        sample.append({k: r.get(k) for k in ['id', 'names', 'taxonomy', 'basic_category', 'sources', 'addresses']})
    (directory/'postal-place-candidates.json').write_text(json.dumps(sample, indent=2, default=str))
    result = {
        'checked_at': datetime.now(timezone.utc).isoformat(),
        'overture_release': release,
        'boundary': {'source': BOUNDARY, 'sha256': digest(boundary_path), 'selection': 'Census 2024 1:500k New Jersey polygon; geometry covers point'},
        'atp': {'url': ATP, 'sha256': digest(atp_path), 'national_records': len(national), 'nj_labelled': len(labelled),
                'inside_nj_boundary': len(atp), 'unique_refs_in_nj': len({f['properties']['ref'] for f in atp}),
                'collection_times_in_nj': sum(bool(f['properties'].get('collection_times')) for f in atp),
                'indoor_in_nj': sum(f['properties'].get('indoor') == 'yes' for f in atp)},
        'overture_infrastructure': {'all_carrier_post_boxes_in_nj': len(boxes), 'carrier_counts': dict(Counter(carrier(r) for r in boxes)),
                                    'explicit_usps_in_nj': len(usps), 'usps_collection_times_in_nj': len(times),
                                    'exact_usps_ref_matches_to_atp': len(ref_matches), 'ref_matches_with_both_times': len(both_times),
                                    'ref_matches_with_identical_time_strings': len(identical_times),
                                    'source_datasets': dict(sources), 'source_tag_keys': dict(Counter(k for r in boxes for k in source_tags(r))),
                                    'inputs': infra_inputs},
        'overture_places': {'all_places_in_nj': len(rows), 'broad_postal_candidates': len(postal_places),
                            'mailbox_text_or_category_candidates': len(candidates),
                            'mailbox_candidates': [{'id': r['id'], 'name': (r.get('names') or {}).get('primary'),
                                                    'category': (r.get('taxonomy') or {}).get('primary')} for r in candidates],
                            'atp_source_entries_in_nj': len(atp_place_sources),
                            'atp_sourced_places_in_nj': sum(any(s.get('dataset') == 'AllThePlaces' for s in (r.get('sources') or [])) for r in rows),
                            'distinct_atp_source_ids_in_nj': len(atp_place_ids),
                            'atp_collection_box_feature_ids_matched': len(atp_ids & atp_place_ids),
                            'postal_categories': dict(Counter((r.get('taxonomy') or {}).get('primary') for r in postal_places)),
                            'postal_source_datasets': dict(place_sources),
                            'input_columns': places.column_names, 'inputs': places_inputs},
        'proximity_explicit_usps': overlap(atp, usps),
        'proximity_unknown_carrier': overlap(atp, unknown),
    }
    (directory/'comparison.json').write_text(json.dumps(result, indent=2, default=str)+'\n')
    print(json.dumps(result, indent=2, default=str), flush=True)


if __name__ == '__main__':
    main()
